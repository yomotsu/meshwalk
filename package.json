{
  "name": "meshwalk",
  "version": "1.0.0",
  "author": "Yomotsu",
  "license": "MIT",
  "type": "module",
  "module": "dist/meshwalk.module.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/meshwalk.module.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yomotsu/meshwalk.git"
  },
  "scripts": {
    "dev": "rollup --config --watch",
    "build": "rollup --config && terser dist/meshwalk.module.js -o dist/meshwalk.module.min.js --comments '/^!/'",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/three": "^0.185.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "lint-staged": "^17.2.0",
    "rollup": "^4.62.3",
    "terser": "^5.49.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "camera-controls": "^3.1.2"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "browserslist": [
    "> 1%",
    "last 3 versions",
    "not dead"
  ],
  "keywords": [
    "three",
    "three.js",
    "tps",
    "game",
    "collision",
    "physics"
  ]
}
